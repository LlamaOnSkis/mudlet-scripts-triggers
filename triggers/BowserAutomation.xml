				<script>Bowser = Bowser or {}

if not Bowser.sacrificeReady then
    return
end

local hp = tonumber(matches[2])

local satiation = nil

if gmcp.Char
and gmcp.Char.Guild
and gmcp.Char.Guild.Slices then
    satiation = tonumber(gmcp.Char.Guild.Slices.Satiation)
end

-- Make sure we have valid data
if not hp or not satiation then
    cecho("\n&lt;red&gt;[SAC] Missing HP or satiation data\n")
    Bowser.sacrificeReady = false
    return
end

-- Sacrifice only above 65% HP and below 35% satiation
if hp &gt; 55 and satiation &lt; 35 then
    cecho(string.format(
        "\n&lt;green&gt;[SAC] Sacrificing -- HP %d%% | Satiation %d%%\n",
        hp,
        satiation
    ))

    send("sacrifice")
else
    cecho(string.format(
        "\n&lt;yellow&gt;[SAC] Skipped -- HP %d%% | Satiation %d%%\n",
        hp,
        satiation
    ))    

end

Bowser.sacrificeReady = false</script>
